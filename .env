# Runtime overrides
# Full template is in .env.example

# Image tags
PII_IMAGE_REPO=xcn-pii
PII_IMAGE_TAG=1.0.0
UVICORN_WORKERS=1
PII_HTTP_MAX_UPLOAD_MB=100
GRPC_INSTALL_SEMANTIC=true
HTTP_INSTALL_SEMANTIC=true
PII_GRPC_MAX_WORKERS=6
PII_HS_COMBINED_ENABLED=true
PII_CONTEXT_ENABLED=true
PII_CONTEXT_EMBED_MAX_CHARS=256
PII_EMBED_DEVICE=auto
PII_RULESET=default
PII_MODEL_PRELOAD_ENABLED=true
PII_GUARDRAIL_ENABLED=false
PII_GUARDRAIL_PROVIDER=sguard
PII_GUARDRAIL_DEVICE=cuda
PII_GUARDRAIL_MAX_CHARS=4000
PII_GUARDRAIL_FAIL_OPEN=true
PII_SGUARD_CONTENT_ENABLED=true
PII_SGUARD_CONTENT_MODEL=SamsungSDS-Research/SGuard-ContentFilter-2B-v1
PII_SGUARD_CONTENT_THRESHOLDS=0.5,0.5,0.5,0.5,0.5
PII_SGUARD_JAILBREAK_ENABLED=true
PII_SGUARD_JAILBREAK_MODEL=SamsungSDS-Research/SGuard-JailbreakFilter-2B-v1
PII_SGUARD_JAILBREAK_THRESHOLD=0.6
PII_LOG_LEVEL=INFO

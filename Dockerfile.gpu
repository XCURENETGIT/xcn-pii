ARG GPU_PYTHON_SOURCE=xcn-pii/api:1.0.0

FROM python:3.11-slim AS app-builder

WORKDIR /app

COPY VERSION /app/VERSION
COPY setup.py /app/setup.py

RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential \
 && rm -rf /var/lib/apt/lists/* \
 && pip install --no-cache-dir Cython

COPY app ./app
RUN python setup.py build_ext --inplace \
 && find /app/app -type f -name '*.so' -exec strip --strip-unneeded {} + \
 && find /app/app -type f -name '*.py' \
      ! -name '__init__.py' \
      ! -name 'main.py' \
      ! -name 'grpc_server.py' \
      ! -name 'context_debug_api.py' \
      ! -name 'detection_exclusions.py' \
      ! -name 'logging_utils.py' \
      ! -name 'logrotate.py' \
      ! -name 'pii.py' \
      ! -name 'response_builders.py' \
      ! -name 'rules_loader.py' \
      ! -name 'schemas.py' \
      ! -path '/app/app/pii_engine/*' \
      ! -path '/app/app/proto/*' \
      ! -path '/app/app/rules/*' \
      ! -path '/app/app/static/*' \
      -delete \
 && find /app/app -type f -name 'test_*.py' -delete \
 && find /app/app -type f -name '*.c' -delete \
 && find /app/app -type d -name '__pycache__' -prune -exec rm -rf {} + \
 && rm -rf /app/build

# The 52 build server keeps this CUDA 13/PyTorch 2.11 image as the validated
# GPU dependency source. Copying its Python runtime avoids downloading several
# gigabytes of CUDA wheels for every application-only release.
FROM ${GPU_PYTHON_SOURCE} AS gpu-python-source

FROM python:3.11-slim AS gpu-runtime-common

ARG INSTALL_SEMANTIC=true

WORKDIR /app

COPY --from=gpu-python-source /usr/local /usr/local
COPY requirements-base.txt requirements-semantic-gpu.txt ./

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && pip install --no-cache-dir -r requirements-base.txt \
 && if [ "$INSTALL_SEMANTIC" = "true" ]; then pip install --no-index -r requirements-semantic-gpu.txt; fi \
 && python -c 'import torch; assert torch.__version__.startswith("2.11."); assert torch.version.cuda == "13.0"'

ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility
ENV PII_EMBED_DEVICE=cuda

FROM gpu-runtime-common AS http-runtime

COPY requirements-http.txt ./
RUN pip install --no-cache-dir -r requirements-http.txt

COPY bin /app/bin
RUN chmod +x /app/bin/xutf_8

COPY --from=app-builder /app/VERSION /app/VERSION
COPY --from=app-builder /app/app /app/app

EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]

FROM gpu-runtime-common AS grpc-runtime

COPY requirements-grpc.txt ./
RUN pip install --no-cache-dir -r requirements-grpc.txt

COPY --from=app-builder /app/VERSION /app/VERSION
COPY --from=app-builder /app/app /app/app

EXPOSE 50051
CMD ["python", "-m", "app.grpc_server"]

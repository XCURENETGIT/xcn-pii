        "CRN": [
          "123가 4567"
        ],
        "IMEI": [
          "490154203237518"
        ],
        "MCN": [
          "AA:BB:CC:DD:EE:FF"
        ]
      }
    },
    {
      "id": "탐지_구분자변형",

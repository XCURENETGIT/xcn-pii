{
  "description": "CPN/CRN/IMEI/MCN 탐지/미탐 혼합 테스트 샘플입니다. 각 케이스의 request.text를 HTTP 또는 gRPC Detect 요청으로 전송해 검증할 수 있습니다.",
  "pii_types": [
    "CPN",
    "CRN",
    "IMEI",
    "MCN"
  ],
  "cases": [
    {
      "id": "탐지_한국어라벨_전체유형",
      "purpose": "한국어 라벨이 있으면 신규 4개 유형이 모두 탐지되어야 합니다.",
      "request": {
        "text": "법인 등록번호 110111-1234569\n자동차 등록번호 123가 4567\n단말기 IMEI 490154203237518\nMAC 주소 AA:BB:CC:DD:EE:FF",
        "max_results_per_type": 20,
        "ruleset": "default"
      },
      "expected": {
        "CPN": [
          "110111-1234569"
        ],
        "CRN": [
          "123가 4567"
        ],
        "IMEI": [
          "490154203237518"
        ],
        "MCN": [
          "AA:BB:CC:DD:EE:FF"
        ]
      }
    },
    {
      "id": "탐지_별칭라벨_전체유형",

      "request": {
        "text": "법인 등기 번호 1101-11-123456-9\n구형 차량번호 서울 1가 2345\n신형 차량번호 123허 4567\ndevice imei 49015420-323751-8\n장비 MAC aabb.ccdd.eeff",
        "max_results_per_type": 20,
        "ruleset": "default"
      },
      "expected": {

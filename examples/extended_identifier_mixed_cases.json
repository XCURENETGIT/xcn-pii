      "request": {
        "text": "corporate registration number: 110111-1234569\nvehicle registration number: 123가 4567\nmobile equipment identity: 490154203237518\nphysical address: AA-BB-CC-DD-EE-FF",
        "max_results_per_type": 20,
        "ruleset": "default"
      },
      "expected": {
        "CPN": [
          "110111-1234569"
        ],
        "CRN": [
          "123가 4567"
        ],

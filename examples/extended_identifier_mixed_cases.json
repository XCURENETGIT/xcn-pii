      "request": {
        "text": "법인등기번호 110111-1234569\n차번 123가 4567\n단말기 고유번호 490154203237518\n네트워크 인터페이스 AA:BB:CC:DD:EE:FF",
        "max_results_per_type": 20,
        "ruleset": "default"
      },
      "expected": {
        "CPN": [
          "110111-1234569"

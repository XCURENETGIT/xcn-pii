          "1101-11-123456-9"
        ],
        "CRN": [
          "서울 1가 2345",
          "123허 4567"
        ],
        "IMEI": [
          "49015420-323751-8"
        ],
        "MCN": [
          "aabb.ccdd.eeff"
        ]
      }
    },
    {
      "id": "탐지_영문라벨_전체유형",

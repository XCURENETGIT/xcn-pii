# Image tags
PII_IMAGE_REPO=xcn-pii
PII_IMAGE_TAG=1.0.8

# HTTP
UVICORN_WORKERS=1
HTTP_INSTALL_SEMANTIC=true
PII_HTTP_MAX_UPLOAD_MB=100
PII_HTTPS_PORT=8443
PII_HTTPS_SERVER_NAME=_
PII_HTTPS_CLIENT_MAX_BODY_SIZE=100m
PII_HTTPS_PROXY_READ_TIMEOUT=300s
PII_HTTPS_PROXY_SEND_TIMEOUT=300s

# gRPC
GRPC_INSTALL_SEMANTIC=true
PII_GRPC_MAX_WORKERS=7
PII_GRPC_MAX_CONCURRENT_STREAMS=1024
PII_GRPC_KEEPALIVE_TIME_MS=30000
PII_GRPC_KEEPALIVE_TIMEOUT_MS=10000
PII_GRPC_MAX_CONCURRENT_RPCS=0
PII_DETECT_TIMEOUT_SEC=10
PII_DETECT_PROCESS_WORKERS=4
PII_DETECT_QUEUE_LIMIT=1
PII_DETECT_PROCESS_START_METHOD=spawn
PII_DETECT_WORKER_TORCH_THREADS=1
PII_SPLIT_MAX_WORKERS=1

# Detection
PII_HS_COMBINED_ENABLED=true
PII_CONTEXT_ENABLED=true
PII_CONTEXT_RULE_FIRST_ENABLED=true
PII_CONTEXT_EMBED_MAX_CHARS=256
PII_CONTEXT_EMBED_NORMALIZE_DIGITS=true
PII_EMBED_DEVICE=cpu
PII_HF_OFFLINE=true
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_DATASETS_OFFLINE=1
PII_RULESET=default
PII_MODEL_PRELOAD_ENABLED=true
PII_STAGE_TIMING_ENABLED=false
PII_STAGE_TIMING_LEVEL=INFO

# Logging
PII_LOG_LEVEL=INFO
PII_FILE_LOG_ENABLED=true
PII_LOG_BACKUP_DAYS=30
PII_LOG_REQUEST_TEXT_ENABLED=false
PII_LOG_REQUEST_TEXT_LIMIT=240
PII_LOG_MAX_FILE_MB=100
PII_LOG_TOTAL_MAX_MB=10240
PII_LOG_ROTATE_INTERVAL_SEC=30
PII_DOCKER_LOG_MAX_SIZE=100m
PII_DOCKER_LOG_MAX_FILE=5

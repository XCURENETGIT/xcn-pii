FROM python:3.11-slim AS app-builder

WORKDIR /app

COPY VERSION /app/VERSION
COPY setup.py /app/setup.py

RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential \
 && rm -rf /var/lib/apt/lists/* \
 && pip install --no-cache-dir Cython

COPY app ./app
RUN python setup.py build_ext --inplace \
 && find /app/app -type f -name '*.so' -exec strip --strip-unneeded {} + \
 && find /app/app -type f -name '*.py' \
      ! -name '__init__.py' \
      ! -name 'main.py' \
      ! -name 'grpc_server.py' \
      ! -name 'context_debug_api.py' \
      ! -name 'detection_exclusions.py' \
      ! -name 'logging_utils.py' \
      ! -name 'pii.py' \
      ! -name 'response_builders.py' \
      ! -name 'rules_loader.py' \
      ! -name 'schemas.py' \
      ! -path '/app/app/pii_engine/*' \
      ! -path '/app/app/proto/*' \
      ! -path '/app/app/rules/*' \
      ! -path '/app/app/static/*' \
      -delete \
 && find /app/app -type f -name 'test_*.py' -delete \
 && find /app/app -type f -name '*.c' -delete \
 && find /app/app -type d -name '__pycache__' -prune -exec rm -rf {} + \
 && rm -rf /app/build

FROM python:3.11-slim AS cpu-runtime-common

ARG INSTALL_SEMANTIC=true

WORKDIR /app

COPY requirements-base.txt requirements-semantic.txt ./

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && pip install --no-cache-dir -r requirements-base.txt \
 && if [ "$INSTALL_SEMANTIC" = "true" ]; then pip install --no-cache-dir -r requirements-semantic.txt; fi \
 && rm -rf \
      /usr/local/lib/python3.11/site-packages/torch/test \
      /usr/local/lib/python3.11/site-packages/torch/include \
      /usr/local/lib/python3.11/site-packages/torch/share/cmake \
 && for package_dir in numpy scipy sklearn sympy; do \
      if [ -d "/usr/local/lib/python3.11/site-packages/${package_dir}" ]; then \
        find "/usr/local/lib/python3.11/site-packages/${package_dir}" -depth -type d \
          \( -name test -o -name tests \) -exec rm -rf '{}' +; \
      fi; \
    done

FROM cpu-runtime-common AS http-runtime

COPY requirements-http.txt ./
RUN pip install --no-cache-dir -r requirements-http.txt

COPY bin /app/bin
RUN chmod +x /app/bin/xutf_8

COPY --from=app-builder /app/VERSION /app/VERSION
COPY --from=app-builder /app/app /app/app

EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]

FROM cpu-runtime-common AS grpc-runtime

COPY requirements-grpc.txt ./
RUN pip install --no-cache-dir -r requirements-grpc.txt

COPY --from=app-builder /app/VERSION /app/VERSION
COPY --from=app-builder /app/app /app/app

EXPOSE 50051
CMD ["python", "-m", "app.grpc_server"]
